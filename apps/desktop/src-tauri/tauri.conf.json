{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Terrain Tool",
	"version": "0.1.0",
	"identifier": "local.bro.terraintool",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [{ "title": "Terrain Tool", "width": 1600, "height": 950 }],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
	}
}
